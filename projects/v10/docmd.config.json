{
  "title": "docmd v0.10.2 Beta Test Suite",
  "url": "https://mgks.github.io/beta-test",
  "engine": "js",
  "layout": {
    "spa": true,
    "breadcrumbs": true,
    "header": {
      "enabled": true
    },
    "sidebar": {
      "collapsible": true,
      "defaultCollapsed": false
    },
    "menubar": {
      "enabled": true,
      "position": "top",
      "left": [
        { "text": "Overview", "url": "/" },
        { "text": "Threads v2", "url": "/threads-v2/" },
        { "text": "Tables", "url": "/tables/" }
      ]
    },
    "optionsMenu": {
      "position": "header",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    },
    "banner": {
      "position": "top",
      "content": "**docmd v{{ docmd.version }} Staging** — Testing Threads v2 Discussions, Production Server, Static Assets, MDX & Diagnostics.",
      "dismissible": true,
      "link": {
        "text": "GitHub Release",
        "url": "https://github.com/docmd-io/docmd",
        "external": true
      }
    },
    "footer": {
      "style": "complete",
      "content": "© {{ docmd.buildYear }} docmd.io · Pre-release Staging for v{{ docmd.version }}",
      "branding": true
    }
  },
  "static": ["public"],
  "serve": {
    "port": 3000,
    "host": "127.0.0.1",
    "compress": true,
    "securityHeaders": true,
    "healthCheck": true
  },
  "plugins": {
    "mdx": true,
    "iconify": true,
    "playground": true,
    "seo": true,
    "sitemap": true,
    "search": true,
    "mermaid": true,
    "math": true,
    "threads": {
      "sidebar": true,
      "autoPublish": {
        "seconds": 180,
        "startOn": true
      }
    }
  },
  "variables": {
    "featureRelease": "{{docmd.version}}",
    "testEnvironment": "beta-test",
    "dynamic": [
      "user.name",
      "user.role",
      "user.apiKey"
    ]
  },
  "theme": {
    "name": "default",
    "appearance": "auto",
    "codeHighlight": true
  },
  "markdown": {
    "linkify": true,
    "typographer": true
  },
  "autoTitleFromH1": true,
  "copyCode": true,
  "pageNavigation": true,
  "navigation": [
    {
      "title": "Overview",
      "path": "/"
    },
    {
      "title": "Threads v2 (Discussions & Reviews)",
      "path": "/threads-v2"
    },
    {
      "title": "Large Tables Test",
      "path": "/tables"
    }
  ]
}
