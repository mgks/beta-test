{
  "title": "Default UI + Showcase",
  "engine": "js",
  "layout": {
    "spa": true,
    "breadcrumbs": true,
    "header": {
      "enabled": true
    },
    "sidebar": {
      "collapsible": true,
      "defaultCollapsed": false
    },
    "menubar": {
      "enabled": true,
      "position": "top",
      "left": [
        {
          "text": "Home",
          "url": "/"
        },
        {
          "text": "Mermaid",
          "url": "/mermaid/"
        },
        {
          "text": "Math",
          "url": "/math/"
        },
        {
          "text": "Containers",
          "url": "/containers/"
        },
        {
          "text": "v0.9.1 Test",
          "url": "/v091-containers/"
        },
        {
          "text": "v0.9.8 New",
          "url": "/v098-whats-new/"
        },
        {
          "text": "MD Options",
          "url": "/markdown-options/"
        }
      ]
    },
    "optionsMenu": {
      "position": "header",
      "components": {
        "search": true,
        "themeSwitch": true
      }
    },
    "footer": {
      "style": "complete",
      "content": "docmd beta-test · Default UI + Showcase",
      "branding": true
    },
    "banner": {
      "position": "top",
      "content": "**Welcome to docmd 0.9.8 staging** — Testing new release features including LLMs prompt support & Turkish i18n.",
      "dismissible": true,
      "link": {
        "text": "Release Info",
        "url": "https://github.com/docmd-io/docmd",
        "external": true
      }
    }
  },
  "theme": {
    "name": "default",
    "appearance": "auto",
    "codeHighlight": true
  },
  "markdown": {
    "linkify": true,
    "typographer": true
  },
  "autoTitleFromH1": true,
  "copyCode": true,
  "pageNavigation": true,
  "navigation": [
    {
      "title": "Home",
      "path": "/"
    },
    {
      "title": "Containers",
      "path": "/containers/"
    },
    {
      "title": "v0.9.1 Containers Test",
      "path": "/v091-containers/"
    },
    {
      "title": "GitHub Repo",
      "path": "https://github.com/docmd-io/docmd",
      "external": true
    },
    {
      "title": "Nested Category",
      "children": [
        {
          "title": "Math Rendering",
          "path": "/math/"
        },
        {
          "title": "Mermaid Diagrams",
          "path": "/mermaid/"
        },
        {
          "title": "Subnested Category",
          "children": [
            {
              "title": "Nested Page A",
              "path": "/nested/page-a/"
            },
            {
              "title": "Nested Page B",
              "path": "/nested/subnested/page-b/"
            }
          ]
        }
      ]
    },
    {
      "title": "v0.9.8 What's New",
      "path": "/v098-whats-new/"
    },
    {
      "title": "Markdown Options",
      "path": "/markdown-options/"
    }
  ],
  "plugins": {
    "llms": {
      "enabled": true,
      "prompt": "You are a helpful assistant for the docmd documentation engine. Always answer in a friendly, concise manner and refer users to the relevant docs page when possible.",
      "sections": true
    },
    "math": true,
    "mermaid": true,
    "okf": true,
    "threads": true,
    "seo": {
      "defaultDescription": "Default UI + Showcase — testing every UI component, callout block, and plugin rendering."
    }
  }
}