{
  "title": "Summer + Semantic",
  "engine": "js",
  "layout": {
    "spa": true,
    "breadcrumbs": true,
    "header": { "enabled": true },
    "sidebar": { "collapsible": true },
    "optionsMenu": {
      "position": "header",
      "components": { "search": true, "themeSwitch": true }
    },
    "footer": { "style": "minimal", "content": "docmd beta-test · Summer + Semantic", "branding": false },
    "banners": [
      {
        "position": "top",
        "content": "**Summer Template + Semantic Search 0.9.6**",
        "dismissible": true,
        "link": {
          "text": "View Release",
          "url": "https://github.com/docmd-io/docmd",
          "external": true
        }
      },
      {
        "position": "sidebar-bottom",
        "content": "Staging build running on GitHub Pages with fresh 0.9.6 tarballs.",
        "dismissible": true,
        "link": {
          "text": "Changelog",
          "url": "https://github.com/docmd-io/docmd/releases",
          "external": true
        }
      }
    ]
  },
  "theme": {
    "name": "default",
    "appearance": "dark",
    "codeHighlight": true,
    "template": "summer"
  },
  "autoTitleFromH1": true,
  "copyCode": true,
  "pageNavigation": true,
  "navigation": [
    { "title": "Semantic Home", "path": "/" },
    { "title": "Configuration", "path": "/configuration/" },
    { "title": "External Docs", "path": "https://docs.docmd.io", "external": true },
    {
      "title": "Semantic Nested",
      "children": [
        { "title": "Deployment", "path": "/deployment/" },
        { "title": "Theming", "path": "/theming/" },
        {
          "title": "Subnested Category",
          "children": [
            { "title": "Semantic Page A", "path": "/nested/page-a/" },
            { "title": "Semantic Page B", "path": "/nested/subnested/page-b/" }
          ]
        }
      ]
    }
  ],
  "plugins": {
    "okf": true,
    "seo": { "defaultDescription": "Semantic search project — validates auto-install of docmd-search, onnxruntime-node, and @huggingface/transformers on a fresh deploy." },
    "search": {
      "semantic": true,
      "showConfidence": true
    }
  }
}